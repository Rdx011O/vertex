# ============================================================
# VERTEX — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# ---- Firebase Admin SDK (Server-side) ----------------------
# Get these from: Firebase Console → Project Settings → Service Accounts
# → Generate New Private Key → download the JSON file

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Paste the private key from the service account JSON.
# Keep the quotes and \n characters as-is.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ---- Firebase Web SDK Config (Client-side) -----------------
# Get these from: Firebase Console → Project Settings → Your Apps → Web App
# Add a new Web App if you don't have one yet.

FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abcdef123456

# ---- Bootstrap Admin ---------------------------------------
# The FIRST user who signs up via /admin portal with this email
# will automatically receive the 'admin' role.
BOOTSTRAP_ADMIN_EMAIL=admin@prec.ac.in

# ---- Server ------------------------------------------------
PORT=3000

# ============================================================
# HOW TO CREATE A FIREBASE PROJECT
# ============================================================
# 1. Go to https://console.firebase.google.com/
# 2. Click "Add project" → give it a name (e.g. "vertex-pravara-2026")
# 3. Disable Google Analytics (not needed) → Create project
# 4. In the left sidebar: Authentication → Get Started → Email/Password → Enable → Save
# 5. Project Settings (gear icon) → Service Accounts → Generate New Private Key
#    → Download JSON → copy values into this .env file
# 6. Project Settings → Your Apps → Add App → Web (</>)
#    → Register app → copy firebaseConfig values into this .env file
# ============================================================
